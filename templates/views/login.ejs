<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <link rel="shortcut icon" href="images/favicon.ico" type="image/ico">
    <title>Credentials</title>
</head>
<body>
    <h1 class="login-heading">Enter your Credentials</h1>
    <div class="box">
        <span class="borderLine"></span>
        <form id="authForm" method="POST">
            <div class="mode-tabs" id="modeTabs" role="tablist">
                <button type="button" id="tabLogin" class="mode-tab" role="tab">Log in</button>
                <button type="button" id="tabSignup" class="mode-tab" role="tab">Sign up</button>
            </div>
            <h2 id="formTitle">Enter your Information</h2>
            <div class="inputBox">
                <input type="email" name="email" required="required">
                <span>Email</span>
                <i></i>
            </div>
            <div class="inputBox">
                <input type="password" name="password" required="required">
                <span>Password</span>
                <i></i>
            </div>
            <div id="errorMessage" style="color: red; text-align: center; margin: 10px 0;"></div>
            <br>
            <button type="submit" class="link-class" style="--clr:#fff">Play</button>
        </form>
    </div>
    <script>
        const form = document.getElementById('authForm');
        const formTitle = document.getElementById('formTitle');
        const errorMessage = document.getElementById('errorMessage');
        const tabLogin = document.getElementById('tabLogin');
        const tabSignup = document.getElementById('tabSignup');

        // The user picks the mode explicitly. localStorage only chooses the default,
        // so a returning user on a new browser is no longer forced into signup.
        function setMode(mode) {
            form.action = '/auth?type=' + mode;
            formTitle.textContent = mode === 'login' ? 'Log in to Play' : 'Register to Play';
            tabLogin.style.fontWeight = mode === 'login' ? 'bold' : 'normal';
            tabSignup.style.fontWeight = mode === 'signup' ? 'bold' : 'normal';
            errorMessage.textContent = '';
        }

        tabLogin.onclick = (e) => { e.preventDefault(); setMode('login'); };
        tabSignup.onclick = (e) => { e.preventDefault(); setMode('signup'); };

        setMode(localStorage.getItem('userId') ? 'login' : 'signup');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorMessage.textContent = '';

            const formData = new FormData(form);
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(formData).toString()
            });

            const result = await response.json();
            if (result.success) {
                if (result.userId) {
                    localStorage.setItem('userId', result.userId); // Save userId
                }
                window.location.href = '/instructions'; // Redirect
            } else {
                errorMessage.textContent = result.message;
            }
        });
    </script>
</body>
</html>